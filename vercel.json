{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/c/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/l/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/xem/:code",
      "destination": "/ctv-view.html"
    },
    {
      "source": "/xem",
      "destination": "/ctv-view.html"
    }
  ]
}
